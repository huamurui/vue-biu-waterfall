{
  "name": "vue-biu-waterfall",
  "version": "2.0.0",
  "type": "module",
  "description": "Responsive, content-aware masonry layout components for Vue 3",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build && npm run build:types",
    "build:types": "vue-tsc -p tsconfig.build.json && rollup --config rollup.types.config.mjs",
    "build:demo": "vite build --config vite.demo.config.ts",
    "preview": "vite preview --config vite.demo.config.ts",
    "typecheck": "vue-tsc --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "vue": "^3.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "2.4.6",
    "jsdom": "^29.1.1",
    "rollup": "^4.64.12",
    "rollup-plugin-dts": "^6.5.1",
    "typescript": "~5.9.3",
    "vite": "^7.3.7",
    "vitest": "^5.0.5",
    "vue": "^3.5.44",
    "vue-tsc": "^3.3.13"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/huamurui/vue-biu-waterfall"
  },
  "keywords": [
    "vue",
    "vue3",
    "ts",
    "typescript",
    "waterfall",
    "layout",
    "ui",
    "pinterest"
  ],
  "author": "huamurui",
  "license": "MIT",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "**/*.css"
  ]
}
